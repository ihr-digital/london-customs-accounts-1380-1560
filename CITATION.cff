# Citation metadata for this repository.
#
# GitHub renders this as the "Cite this repository" panel. Zenodo does NOT read
# it: Zenodo reads .zenodo.json, which is authoritative for the deposited record
# and carries the contributor roles this format has no field for. Keep the two
# in step — the author list here and the creators list there must match.
#
# At each release, set `version:` and `date-released:` to match the tag. After the
# FIRST release, add the concept DOI (the "all versions" one, which always resolves
# to the newest release) as `doi:` below — it does not exist until then.
#
#   doi: "10.5281/zenodo.XXXXXXX"
#   date-released: "YYYY-MM-DD"

cff-version: 1.2.0
message: "If you use this data, please cite it as below."
type: dataset
version: "0.0.0-beta"
date-released: "2026-09-11"
title: "London Customs Accounts, 1380-1560: machine-readable data and research tools"
abstract: >-
  Machine-readable data and browser-based research tools for the particular
  customs accounts of the port of London, 1380-1560, produced by the project
  "Unlocking Upcycled Medieval Data: North Sea Networks, People, and Commodities
  in the London Customs Accounts 1380-1560". Comprises 33,548 ladings across 46
  account-book files, a curated glossary of 3,333 commodity headwords aligned to
  Getty AAT and Wikidata, and 246,008 person mentions grouped for identity
  matching.
